# Porta em que o servidor Express vai rodar
PORT=3000

# Chave da API do Google Gemini (NUNCA coloque a chave real direto no código)
GEMINI_API_KEY=

# Segredo usado para assinar os tokens JWT de autenticação (use uma string longa e aleatória)
JWT_SECRET=troque_por_um_segredo_bem_grande_e_aleatorio

# Tempo de validade do token de login (formato aceito pela lib "jsonwebtoken", ex: 7d, 12h, 30m)
JWT_EXPIRES_IN=7d

# Origens (Front-End) que podem falar com esse servidor, separadas por vírgula
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# "production" habilita cookies com flag Secure (exige HTTPS)
NODE_ENV=development
